{
  "name": "plateforme-cinephile",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postinstall": "node scripts/copy-ffmpeg-core.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check:design": "node scripts/check-design.mjs",
    "db:start": "npx -y supabase@2.120.0 start",
    "db:stop": "npx -y supabase@2.120.0 stop",
    "db:reset": "npx -y supabase@2.120.0 db reset",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/db-seed.ts",
    "test:db": "vitest run --config vitest.db.config.mts",
    "test:tmdb": "vitest run --config vitest.live.config.mts tests/live/tmdb-titles.test.ts tests/live/tmdb-title-page.test.ts tests/live/tmdb-watch.test.ts",
    "test:ai": "vitest run --config vitest.live.config.mts tests/live/openai-vision.test.ts",
    "eval:describe": "vitest run --config vitest.live.config.mts tests/live/describe-eval.test.ts",
    "test:quota": "vitest run --config vitest.live.config.mts tests/live/quota-upstash.test.ts tests/live/spend-upstash.test.ts",
    "build:e2e": "node scripts/e2e-build.mjs",
    "test:e2e": "playwright test",
    "fixtures:videos": "node scripts/make-video-fixtures.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.39.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "drizzle-orm": "0.45.3",
    "embla-carousel-autoplay": "8.6.0",
    "embla-carousel-fade": "8.6.0",
    "embla-carousel-react": "8.6.0",
    "heic-to": "1.6.5",
    "lucide-react": "1.52.0",
    "motion": "13.5.1",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "openai": "7.34.0",
    "postgres": "3.4.9",
    "posthog-js": "1.438.3",
    "posthog-node": "5.55.1",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "shadcn": "4.21.4",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
