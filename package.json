{
  "name": "plateforme-cinephile",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check:design": "node scripts/check-design.mjs",
    "db:start": "npx -y supabase@2.120.0 start",
    "db:stop": "npx -y supabase@2.120.0 stop",
    "db:reset": "npx -y supabase@2.120.0 db reset",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/db-seed.ts",
    "test:db": "vitest run --config vitest.db.config.mts"
  },
  "dependencies": {
    "@sentry/nextjs": "11.5.0",
    "@supabase/supabase-js": "2.117.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "drizzle-orm": "0.45.3",
    "lucide-react": "1.52.0",
    "next": "16.3.8",
    "next-themes": "0.4.6",
    "postgres": "3.4.9",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "shadcn": "4.21.4",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
