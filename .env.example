# Copier en .env.local pour le développement. Ne jamais versionner de valeur réelle.
# Liste tenue à jour par src/server/env.ts : chaque unité y ajoute ses variables.

# PostHog : suivi des erreurs et analytique (région UE, sans cookie). Clé de projet « phc_… »
# (PostHog → Settings → Project → General → Project token), jamais une clé personnelle « phx_… ».
# Obligatoire en production, facultative en preview et en local (rien n'est envoyé sans elle).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# Facultatif : https://eu.i.posthog.com par défaut.
NEXT_PUBLIC_POSTHOG_HOST=

# Secret des crons et de /api/health/error-check (32 caractères minimum, différent par environnement).
# Obligatoire en production, facultatif ailleurs.
CRON_SECRET=

# Base de données et Supabase. En local : `npm run db:start`, puis les valeurs affichées
# (DB_URL, API_URL, PUBLISHABLE_KEY, SECRET_KEY ; aussi visibles avec `npx supabase status`).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# U04 : URL et clé publique obligatoires en production (Vercel, Preview et Production). Le navigateur ne s'en sert
# pas : l'authentification passe par le serveur. Pour le test Playwright du compte en local :
# MAILPIT_URL=http://127.0.0.1:54324 npx playwright test tests/e2e/auth.spec.ts
# Clé secrète : contourne la RLS, uniquement côté serveur (jamais en NEXT_PUBLIC_*).
SUPABASE_SECRET_KEY=

# TMDB (U08) : « API Read Access Token » (long jeton eyJ…), themoviedb.org → Paramètres → API.
TMDB_API_TOKEN=
# Upstash Redis (cache TMDB, quotas) : console.upstash.com → base Redis eu-west-1 → REST API.
# Facultatif en local (pas de cache sans lui), obligatoire en production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# OpenAI (U07) : clé de projet « sk-… » (platform.openai.com → projet → API keys). Obligatoire en production.
OPENAI_API_KEY=
# Facultatifs : gpt-6.1-sol et auto par défaut (AD-31) ; à calibrer par l'eval (U13).
OPENAI_VISION_MODEL=
OPENAI_IMAGE_DETAIL=
OPENAI_REASONING_EFFORT=

# Cookie visiteur signé (U11, quota RG2) : chaîne aléatoire de 32 caractères minimum (openssl rand -base64 48),
# différente par environnement. Obligatoire en production ; en local, un secret temporaire est généré.
VISITOR_COOKIE_SECRET=
