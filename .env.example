# Copier en .env.local pour le développement. Ne jamais versionner de valeur réelle.
# Liste tenue à jour par src/server/env.ts : chaque unité y ajoute ses variables.

# Sentry (obligatoires en preview et production, facultatives en local)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Secret des crons et de /api/health/sentry-check (32 caractères minimum, différent par environnement)
CRON_SECRET=

# Build uniquement (Vercel) : envoi des source maps à Sentry
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
