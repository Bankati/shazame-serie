# Copier en .env.local pour le développement. Ne jamais versionner de valeur réelle.
# Liste tenue à jour par src/server/env.ts : chaque unité y ajoute ses variables.

# Sentry (obligatoires en preview et production, facultatives en local)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Secret des crons et de /api/health/sentry-check (32 caractères minimum, différent par environnement)
CRON_SECRET=

# Base de données et Supabase. En local : `npm run db:start`, puis les valeurs affichées
# (DB_URL, API_URL, PUBLISHABLE_KEY, SECRET_KEY ; aussi visibles avec `npx supabase status`).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète : contourne la RLS, uniquement côté serveur (jamais en NEXT_PUBLIC_*).
SUPABASE_SECRET_KEY=

# Build uniquement (Vercel) : envoi des source maps à Sentry
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
